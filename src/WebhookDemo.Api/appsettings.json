{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Webhooks": "Data Source=webhooks.db"
  },
  "Webhooks": {
    "MaxBodyBytes": 262144,
    "Stripe": {
      "SigningSecret": "",
      "Tolerance": "00:05:00"
    },
    "WhatsApp": {
      "AppSecret": "",
      "VerifyToken": ""
    },
    "Forms": {
      "SigningSecret": ""
    }
  },
  "Processing": {
    "Workers": 2,
    "LeaseDuration": "00:00:30",
    "PollInterval": "00:00:01",
    "MaxAttempts": 5,
    "RetryBaseDelay": "00:00:02",
    "RetryMaxDelay": "00:05:00",
    "RetryJitter": 0.2
  },
  "Demo": {
    "Enabled": false
  }
}
